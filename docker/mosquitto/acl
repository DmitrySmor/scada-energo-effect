# =============================================================================
# ACL MQTT-брокера (ТЗ, п.4). Монтируется в контейнер mosquitto
# в /mosquitto/config/acl (пропишите acl_file в mosquitto.conf).
#
# Модель прав:
#   * группа scada_backend  — сервисный аккаунт backend'а;
#   * группа devices        — все зарегистрированные устройства.
#
# Имена пользователей устройств совпадают с device_id (например dev-0001).
# Файл passwd генерируется скриптом scripts/add_device.sh.
# =============================================================================

# --- Backend: читает все телеметрические топики, пишет только подтверждения --
group scada_backend

user $SYS                          # служебные топики брокера не трогаем

# Пример сервисного пользователя backend (имя задаётся в .env как MQTT_USERNAME):
# groupline не обязателен — права даются напрямую пользователю:
topic readwrite scada/v1/#         # приём телеметрии со всех устройств
topic write      scada/v1/+/+/ack  # публикация прикладных подтверждений (ТЗ, п.5.1)
topic read $SYS/broker/#           # мониторинг брокера (опционально)

# --- Устройства ---------------------------------------------------------------
# Каждое устройство может публиковать ТОЛЬКО в свой топик и подписываться
# ТОЛЬКО на собственные подтверждения. Подстановка %u = имя пользователя
# (device_id), поэтому правила универсальны для всех устройств.
group devices

# Публикация: scada/v1/{object_id}/{device_id}/{telemetry|status|diagnostics|event}
# Проверку соответствия object_id/device_id дополнительно выполняет backend.
topic write scada/v1/+/%u/telemetry
topic write scada/v1/+/%u/status
topic write scada/v1/+/%u/diagnostics
topic write scada/v1/+/%u/event

# Подписка: только собственный топик подтверждений (ТЗ, п.6)
topic read scada/v1/+/%u/ack

# Запрет всего остального вытекает из allow_anonymous false и отсутствия
# других правил: попытка записи в чужой топик логируется как нарушение ACL.
