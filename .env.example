# =============================================================================
# Пример файла окружения для развёртывания (ТЗ, п.19).
# Скопируйте в .env и заполните секреты. Файл .env в Git НЕ попадает!
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL / TimescaleDB -------------------------------------------------
POSTGRES_DB=scada
POSTGRES_USER=scada
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD      # секрет!

# --- REST API (FastAPI) --------------------------------------------------------
# JWT-механизм выбран по умолчанию; итоговое решение согласуется (ТЗ, п.21)
SECRET_KEY=CHANGE_ME_RANDOM_64_HEX               # секрет подписи токенов!
ACCESS_TOKEN_EXPIRE_MINUTES=30
FIRST_ADMIN_EMAIL=admin@example.com              # первый администратор (создаётся миграцией/скриптом)
FIRST_ADMIN_PASSWORD=CHANGE_ME                   # смените сразу после установки

# Ограничение частоты запросов (ТЗ, п.15; точные лимиты согласуются, п.21)
RATE_LIMIT_PER_MINUTE=60

# --- MQTT -----------------------------------------------------------------------
# Подключение backend'а к брокеру по внутренней docker-сети (без TLS внутри сети)
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=scada_backend
MQTT_PASSWORD=CHANGE_ME_MQTT_BACKEND_PASSWORD    # секрет!
MQTT_BASE_TOPIC=scada/v1                         # префикс топиков (ТЗ, п.6)
MQTT_ACK_SUFFIX=ack                              # .../{object_id}/{device_id}/ack — подтверждения
TLS_CERT_REQS=                                 # none|optional|required — для внешних подключений

# Устройства публикуют снаружи: mqtts://<сервер>:8883 (TLS обязателен, ТЗ п.4)

# --- Мониторинг устройств (ТЗ, п.14; пороги согласуются, п.21) ------------------
DEVICE_OFFLINE_AFTER_MINUTES=60                  # нет данных дольше — уведомление
TASKS_TIMEZONE=UTC

# --- Резервные копии (ТЗ, п.17) ---------------------------------------------------
BACKUP_DIR=/backups/iot-project                  # ОБЯЗАТЕЛЬНО отдельный диск!
BACKUP_RETAIN_DAYS=30

# --- Прочее ----------------------------------------------------------------------
LOG_LEVEL=INFO
TZ=UTC
